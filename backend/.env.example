# Django — local / testing (match Hostinger stack: MySQL + Redis off)
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database — MySQL (same as Hostinger production). Use a LOCAL or STAGING DB only.
# Example after: .\scripts\setup-local-mysql.ps1 -RootPassword "..."
# If password has @ encode it as %40 (e.g. MalwaLocal@2026 → MalwaLocal%402026)
DATABASE_URL=mysql://malwa_local:MalwaLocal%402026@127.0.0.1:3306/malwa_solar_local

# Redis — keep disabled to match Hostinger VPS production
REDIS_URL=disabled

# CORS — React frontend URL
# Local: http://localhost:5173
# Prod:  https://crm.ecomalwa.com
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Email (optional — for notifications)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=Malwa Solar CRM <your@gmail.com>

# Media files
# MEDIA_ROOT=

# Optional S3 media storage — set bucket name to enable in production.py
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_REGION_NAME=ap-south-1
# AWS_S3_CUSTOM_DOMAIN=
# AWS_DEFAULT_ACL=private
# AWS_QUERYSTRING_AUTH=True
