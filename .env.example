# Frontend env (copy to .env.local)
# For LAN testing on same WiFi, leave VITE_API_URL unset — Vite dev server proxies /api to backend.
# VITE_API_URL=http://127.0.0.1:8000/api/v1
# Microservices gateway (after .\scripts\run-all-microservices.ps1 + Caddy):
# VITE_API_URL=http://127.0.0.1:8080/api/v1

VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here